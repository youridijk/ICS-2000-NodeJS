{
  "name": "ics-2000",
  "version": "1.3.1",
  "description": "A library to control your KAKU devices through the ICS-2000 and read P1 data from ICS-2000",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node .",
    "start:server": "node ./dist/start-server.js",
    "dev": "nodemon -w 'src/**/*' --ext '*.ts' --exec 'tsc && npm start'",
    "dev:server": "nodemon -w 'src/**/*' --ext '*.ts' --exec 'tsc && npm run start:server -- --useEnv'",
    "build": "rimraf ./dist && tsc",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "express": "^5.3.0"
  },
  "allowScripts": {
    "fsevents": false
  },
  "keywords": [
    "kaku",
    "ics-2000",
    "klikaanklikuit",
    "ics2000"
  ]
}
